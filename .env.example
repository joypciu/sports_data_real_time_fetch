# ================================
# Stats API (stats_api.py)
# ================================

# Bearer token for the stats API.
# Requests must include: Authorization: Bearer <token>
# Leave blank to disable authentication (internal VPS-only use).
STATS_API_TOKEN=

# Port the stats API listens on (default: 8001).
STATS_API_PORT=8001

# ================================
# SofaScore proxies (required on VPS — Cloudflare blocks datacenter IPs)
# ================================
# Scraper proxy: used ONLY by sofascore_ingest.py (background cache build).
# Use a RESIDENTIAL or mobile proxy here — datacenter proxies often get 403 too.
# Format: http://user:pass@host:port  or  socks5://user:pass@host:port
SOFASCORE_SCRAPER_PROXY=

# Live settlement fallback proxy (stats_api prop_check when cache misses).
# Can be the same URL as SOFASCORE_SCRAPER_PROXY or a different one.
SOFASCORE_PROXY=

# Timeouts (seconds)
SOFASCORE_CONNECT_TIMEOUT=5
SOFASCORE_READ_TIMEOUT=20

# Ingest pacing — slower = less likely to trigger rate limits / Cloudflare
SOFASCORE_INGEST_BATCH_DELAY=2.0
SOFASCORE_DETAIL_DELAY=0.8
# If scraper proxy gets Cloudflare 403, retry ingest without proxy (works on residential IP)
SOFASCORE_PROXY_FALLBACK_DIRECT=true

# Browser fingerprint list (curl_cffi impersonate profiles, comma-separated)
SOFASCORE_IMPERSONATE_LIST=chrome131,chrome124,chrome120

# ================================
# Flashscore / sportdb.dev enrichment (enrich_flashscore.py)
# ================================

# API key for sportdb.dev — required for Flashscore period scores,
# match stats, odds, and Transfermarkt market value enrichment.
# Sign up at https://sportdb.dev
SPORTDB_API_KEY=

# ================================
# CI/CD Smoke Test Email Alerts
# Used by GitHub Actions to email you when the post-deploy smoke test fails.
# Add these as GitHub repository secrets (Settings → Secrets → Actions):
#   GMAIL_SENDER       – Gmail address that sends the alert
#   GMAIL_APP_PASSWORD – 16-char Gmail App Password (NOT your real password)
#                        Generate at: https://myaccount.google.com/apppasswords
#   ADMIN_EMAIL        – Address that receives the alert (can be any email)
# ================================
GMAIL_SENDER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
ADMIN_EMAIL=you@example.com
